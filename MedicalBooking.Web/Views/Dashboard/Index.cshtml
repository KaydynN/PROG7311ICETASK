@model MedicalBooking.Web.Models.AppointmentReport

<div class="page-header">
    <h2>Welcome back 👋</h2>
    <p class="text-muted">Here’s your system overview</p>
</div>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-calendar fs-1 text-primary"></i>
            <h6 class="mt-2 text-muted">Total</h6>
            <h2>@Model.TotalAppointments</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-check-circle fs-1 text-success"></i>
            <h6 class="mt-2 text-muted">Attended</h6>
            <h2>@Model.AttendedCount</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-x-circle fs-1 text-danger"></i>
            <h6 class="mt-2 text-muted">Missed</h6>
            <h2>@Model.MissedCount</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-hourglass fs-1 text-warning"></i>
            <h6 class="mt-2 text-muted">Pending</h6>
            <h2>@Model.PendingCount</h2>
        </div>
    </div>

</div>

<hr />

<div class="mt-4">
    <a class="btn btn-primary me-2" asp-controller="Appointments" asp-action="Create">
        <i class="bi bi-plus-circle"></i> Book Appointment
    </a>

    <a class="btn btn-secondary me-2" asp-controller="Appointments" asp-action="Index">
        <i class="bi bi-list"></i> View Bookings
    </a>

    <a class="btn btn-success" asp-controller="Reports" asp-action="Index">
        <i class="bi bi-bar-chart"></i> View Analytics
    </a>
</div>