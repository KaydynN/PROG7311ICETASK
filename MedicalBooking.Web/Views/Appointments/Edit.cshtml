@model MedicalBooking.Web.Models.Appointment

@{
    ViewData["Title"] = "Reschedule Appointment";
}

<h2 class="mb-3">Reschedule Appointment</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<div class="card p-4 shadow-sm">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="PatientName" class="form-label">Patient</label>
            <input asp-for="PatientName" class="form-control" readonly />
            <span asp-validation-for="PatientName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Practitioner" class="form-label">Practitioner</label>
            <input asp-for="Practitioner" class="form-control" readonly />
            <span asp-validation-for="Practitioner" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AppointmentDate" class="form-label">Appointment Date</label>
            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control"
                   value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="Reason" />
        <input type="hidden" asp-for="Attended" />

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}