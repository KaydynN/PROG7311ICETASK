@model MedicalBooking.Web.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<div class="card p-4 shadow-sm">

    <form asp-action="Create" method="post">

        <!-- Patient Name -->
        <div class="mb-3">
            <label asp-for="PatientName" class="form-label"></label>
            <input asp-for="PatientName" class="form-control" />
            <span asp-validation-for="PatientName" class="text-danger"></span>
        </div>

        <!-- Practitioner -->
        <div class="mb-3">
            <label asp-for="Practitioner" class="form-label"></label>
            <input asp-for="Practitioner" class="form-control" />
            <span asp-validation-for="Practitioner" class="text-danger"></span>
        </div>

        <!-- Appointment Date (FIXED IMPORTANT PART) -->
        <div class="mb-3">
            <label asp-for="AppointmentDate" class="form-label"></label>

            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control"
                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />

            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <!-- Reason -->
        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <!-- Buttons -->
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Save Appointment
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}