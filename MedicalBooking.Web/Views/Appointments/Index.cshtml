@model List<MedicalBooking.Web.Models.Appointment>

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>Patient Bookings</h2>
        <p class="text-muted">Manage all scheduled appointments</p>
    </div>

    <a class="btn btn-success" asp-action="Create">
        <i class="bi bi-plus-circle"></i> New Booking
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No appointments found.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Reason</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientName</td>
                    <td>@item.Practitioner</td>
                    <td>@item.AppointmentDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@item.Reason</td>
                    <td>
                        @if (item.Attended)
                        {
                            <span class="badge bg-success">Attended</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to delete this appointment?');"
                              class="d-inline">
                            <button class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}