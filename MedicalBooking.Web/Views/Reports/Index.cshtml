@model MedicalBooking.Web.Models.AppointmentReport

<div class="page-header">
    <h2>Analytics Overview 📊</h2>
    <p class="text-muted">Insights into appointments and performance</p>
</div>

<!--  TOP CARDS (MATCH DASHBOARD STYLE) -->
<div class="row g-4">

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-calendar fs-1 text-primary"></i>
            <h6 class="mt-2 text-muted">Total</h6>
            <h2>@Model.TotalAppointments</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-check-circle fs-1 text-success"></i>
            <h6 class="mt-2 text-muted">Attended</h6>
            <h2>@Model.AttendedCount</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-x-circle fs-1 text-danger"></i>
            <h6 class="mt-2 text-muted">Missed</h6>
            <h2>@Model.MissedCount</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-4 text-center">
            <i class="bi bi-hourglass fs-1 text-warning"></i>
            <h6 class="mt-2 text-muted">Pending</h6>
            <h2>@Model.PendingCount</h2>
        </div>
    </div>

</div>

<hr class="my-4" />

<!--  PRACTITIONER ANALYTICS TABLE -->
<div class="card p-4">
    <h4 class="mb-3">Appointments Per Practitioner</h4>

    @if (!Model.AppointmentsPerPractitioner.Any())
    {
        <div class="alert alert-info">No data available.</div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th><i class="bi bi-person-badge"></i> Practitioner</th>
                    <th><i class="bi bi-bar-chart"></i> Total Appointments</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.AppointmentsPerPractitioner)
                {
                    <tr>
                        <td>@item.Key</td>
                        <td>
                            <span class="badge bg-primary fs-6">@item.Value</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<canvas id="appointmentsChart" height="100"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const data = {
    labels: ["Total", "Attended", "Missed", "Pending"],
    datasets: [{
    label: "Appointments Overview",
    data: [
    @Model.TotalAppointments,
    @Model.AttendedCount,
    @Model.MissedCount,
    @Model.PendingCount
    ]
    }]
    };

    const config = {
    type: 'bar',
    data: data
    };

    new Chart(document.getElementById('appointmentsChart'), config);
</script>